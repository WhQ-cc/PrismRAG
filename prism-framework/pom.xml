<?xml version="1.0" encoding="UTF-8"?>
<!--
  prism-framework —— 框架层
  职责：线程池隔离（入库/向量化/检索/问答各用各的池）、Trace 上下文跨线程透传、
        SSE 连接注册表（支持客户端断开后取消后端任务）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.prism</groupId>
        <artifactId>prism-rag-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>prism-framework</artifactId>
    <name>prism-framework</name>
    <description>框架层：线程池隔离、上下文透传、SSE 连接管理</description>

    <dependencies>
        <dependency>
            <groupId>com.prism</groupId>
            <artifactId>prism-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>
</project>
