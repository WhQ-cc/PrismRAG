# ===========================================================================
# PrismRAG .gitignore
# 目标：只保留「源码 + 文档 + 配置」三类核心内容，
#       构建产物、运行数据、IDE 配置一律不入库。
# ===========================================================================

# ===== 构建产物 =====
target/
!.mvn/wrapper/maven-wrapper.jar
*.jar
*.war
*.class
.flattened-pom.xml
*.hprof

# ===== 运行期数据 =====
# 本地 H2 数据库（data/ 下），属于运行状态，不应进仓库
data/
logs/
*.log
npm-debug.log*
yarn-error.log*
*.db
*.mv.db
*.trace.db
*.lock
*.pid

# ===== IDE =====
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
nbproject/


docs/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编辑器临时文件 =====
*.swp
*.swo
*~
.#*
